{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenpunk.local/contracts/authoring/v1/Request.schema.json",
  "$ref": "#/$defs/Request",
  "$defs": {
    "ScreenFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "maxBytes": 160,
          "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*\\.(?:html|css|js|json|svg|txt)$"
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 204800,
          "maxBytes": 204800
        }
      },
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "Screen": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "maxBytes": 400,
          "x-screenpunk-max-utf16-code-units": 100
        },
        "entry": {
          "const": "index.html"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScreenFile"
          },
          "maxItems": 20,
          "minItems": 1
        }
      },
      "required": [
        "title",
        "entry",
        "files"
      ],
      "additionalProperties": false
    },
    "CapabilityState": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "http",
            "event"
          ]
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "maxBytes": 128
          },
          "maxItems": 16,
          "minItems": 0
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "maxBytes": 8192
        }
      },
      "required": [
        "name",
        "kind",
        "inputSchema",
        "outputSchema",
        "requirements",
        "instructions"
      ],
      "additionalProperties": false
    },
    "Service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "provider": {
          "type": "string",
          "enum": [
            "home",
            "googleTV",
            "googleCalendar",
            "appleMaps",
            "publicHTTP"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "supported": {
          "$ref": "#/$defs/CapabilityState"
        },
        "configured": {
          "$ref": "#/$defs/CapabilityState"
        },
        "authorized": {
          "$ref": "#/$defs/CapabilityState"
        },
        "entitled": {
          "$ref": "#/$defs/CapabilityState"
        },
        "reachable": {
          "$ref": "#/$defs/CapabilityState"
        }
      },
      "required": [
        "id",
        "provider",
        "operations",
        "supported",
        "configured",
        "authorized",
        "entitled",
        "reachable"
      ],
      "additionalProperties": false
    },
    "Preference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "profile",
            "device",
            "screen"
          ]
        },
        "targetID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096,
              "maxBytes": 4096
            },
            {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "originRequestID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scope",
        "targetID",
        "category",
        "value",
        "revision",
        "originRequestID",
        "deleted"
      ],
      "additionalProperties": false
    },
    "Mutation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "upsert",
            "delete"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "expectedRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "record": {
          "$ref": "#/$defs/Preference"
        }
      },
      "required": [
        "kind",
        "id",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "Authorization": {
      "type": "object",
      "properties": {
        "requestID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "maxBytes": 4096
        }
      },
      "required": [
        "requestID",
        "quote"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadlineAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "designGuidance": {
          "type": "object",
          "properties": {
            "version": {
              "const": "1"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "maxBytes": 8192
              },
              "maxItems": 64,
              "minItems": 1
            }
          },
          "required": [
            "version",
            "rules"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "version": {
              "const": "1"
            },
            "packageFormat": {
              "const": "utf8-files-v1"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "maxBytes": 128
              },
              "maxItems": 64,
              "minItems": 0
            },
            "limits": {
              "type": "object",
              "properties": {
                "metadataBytes": {
                  "const": 131072
                },
                "requestBytes": {
                  "const": 393216
                },
                "screenBytes": {
                  "const": 204800
                },
                "screenFiles": {
                  "const": 20
                }
              },
              "required": [
                "metadataBytes",
                "requestBytes",
                "screenBytes",
                "screenFiles"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "packageFormat",
            "features",
            "limits"
          ],
          "additionalProperties": false
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          },
          "maxItems": 32,
          "minItems": 0
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Preference"
          },
          "maxItems": 128,
          "minItems": 0
        },
        "context": {
          "type": "object",
          "properties": {
            "profileID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "maxBytes": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "deviceID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "maxBytes": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "screenID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "maxBytes": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "baseRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "maxBytes": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "userRequest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "maxBytes": 16384
            },
            "currentScreen": {
              "$ref": "#/$defs/Screen"
            },
            "viewport": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                },
                "scale": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 8
                },
                "orientation": {
                  "type": "string",
                  "enum": [
                    "portrait",
                    "landscape"
                  ]
                }
              },
              "required": [
                "width",
                "height",
                "scale",
                "orientation"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "profileID",
            "deviceID",
            "screenID",
            "baseRevision",
            "userRequest",
            "viewport"
          ],
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string",
              "enum": [
                "cloud",
                "fixture",
                "local"
              ]
            },
            "contractVersion": {
              "const": "1"
            },
            "snapshotDigest": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "maxBytes": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "route",
            "contractVersion",
            "snapshotDigest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "requestID",
        "createdAt",
        "deadlineAt",
        "designGuidance",
        "runtime",
        "services",
        "preferences",
        "context",
        "delivery"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "inputDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "maxBytes": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "maxBytes": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferenceRevisions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "maxBytes": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxProperties": 128
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "screen": {
          "$ref": "#/$defs/Screen"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "maxBytes": 64000,
          "x-screenpunk-max-utf16-code-units": 16000
        },
        "preferenceMutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mutation"
          },
          "maxItems": 16,
          "minItems": 0
        },
        "durablePreferenceAuthorization": {
          "$ref": "#/$defs/Authorization"
        }
      },
      "required": [
        "schemaVersion",
        "requestID",
        "inputDigest",
        "baseRevision",
        "preferenceRevisions",
        "operationID"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "operationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "maxBytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "inputDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "maxBytes": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "conflict",
            "rejected"
          ]
        },
        "appliedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "maxBytes": 4096
        }
      },
      "required": [
        "schemaVersion",
        "requestID",
        "operationID",
        "inputDigest",
        "status",
        "appliedAt"
      ],
      "additionalProperties": false
    }
  }
}
