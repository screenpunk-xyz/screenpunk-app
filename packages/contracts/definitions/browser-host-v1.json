  "policy": {
    "publicHTTP": {
      "origins": [
        "https://api.weather.gov",
        "https://mapservices.weather.noaa.gov",
        "https://basemap.nationalmap.gov",
        "https://www.nasa.gov",
        "https://images-assets.nasa.gov"
      ],
      "jsonBytes": 1048576,
      "rasterBytes": 4194304,
      "rasterTypes": [
        "image/png",
        "image/jpeg"
      ],
      "rasterMaxDimension": 4096,
      "rasterMaxPixels": 4194304,
      "maxInFlight": 4,
      "readsPerMinute": 60
    },
    "state": {
      "bytesPerValue": 16384,
      "bytesPerScreen": 131072,
      "keysPerScreen": 128,
      "maxJSONDepth": 16
    },
    "storage": {
      "localBytesPerScreen": 524288,
      "sessionBytesPerDocument": 524288
    },
    "pages": {
      "maxPages": 64
    }
  }
}
